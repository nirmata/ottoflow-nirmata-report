# Required — from Slack app settings
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Required — Nirmata credentials
NIRMATA_URL=p2.nirmata.co
NIRMATA_API_KEY=your-api-key-here

# Optional — paths (defaults work if running alongside the repo)
OTTOFLOW_BIN=ottoflow          # or /path/to/ottoflow/bin/ottoflow
WORKFLOW_DIR=/app/workflow     # directory containing workflow.yaml

PORT=3000
